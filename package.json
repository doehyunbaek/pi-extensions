{
  "name": "pi-extensions",
  "private": true,
  "workspaces": [
    "multicodex",
    "litellm",
    "system-prompt"
  ],
  "scripts": {
    "check": "npm run check:multicodex && npm run check --workspace=pi-provider-litellm",
    "check:multicodex": "npm run lint --workspace=pi-multicodex && npm test --workspace=pi-multicodex && npm run tsgo --workspace=pi-multicodex",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16"
  },
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doehyunbaek/pi-extensions.git"
  },
  "pi": {
    "extensions": [
      "./multicodex/index.ts",
      "./litellm/index.ts",
      "./system-prompt/index.ts"
    ]
  }
}
