{
  "name": "pi-extensions",
  "private": true,
  "workspaces": [
    "litellm",
    "system-prompt",
    "autogist"
  ],
  "scripts": {
    "check": "npm run check --workspace=pi-provider-litellm",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16"
  },
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doehyunbaek/pi-extensions.git"
  },
  "pi": {
    "extensions": [
      "./litellm/index.ts",
      "./system-prompt/index.ts",
      "./autogist/index.ts"
    ]
  }
}
